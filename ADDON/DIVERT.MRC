  .timer 1 1 unset %figz.talker
  return %figz.talker
}









fecho.n { 
  if (%fecho.n == $null) { set %fecho.n 12 } | fecho %fecho.n $1- 
}
fecho { 
  if (%fecho == r) { echo $rand(1,15) -a  $2- } | else { echo $$1 -a $2- } 
}
fecho { if (%fecho == r) { echo $rand(1,15) -a  $2- } | else { echo $$1 -a $2- } }
fecho.e { if (%fecho.e == $null) { set %fecho.e 4 } | fecho %fecho.e $1- }
fecho.n { if (%fecho.n == $null) { set %fecho.n 10 } | fecho %fecho.n $1- }
fecho.o { if (%fecho.o == $null) { set %fecho.o 2 } | fecho %fecho.o $1- }
fecho.p { if (%fecho.p == $null) { set %fecho.p 1 } | fecho %fecho.p $1- }
Pizzatk { 
  unset %figz.talker.weird %figz.talker.alternate %frtkvar %ttalktk %frtkvar %ttecetk | set %figz.talker.figz on | fecho.n %sd $figz.talker.figz(Ora si parla cosi! pizza) 
}
normtk { 
  unset %figz.talker.figz %figz.talker.weird %figz.talker.alternate %frtkvar %ttalktk %ttecetk | fecho.n %sd Ora si parla normalmente 
}
weirdtk { 
  unset %figz.talker.figz %figz.talker.alternate %frtkvar %ttalktk %ttecetk | set %figz.talker.weird on | fecho.n %sd $figz.talker.weird(Ora si parla da  Elite) 
}
frtk { 
  unset %figz.talker.figz %figz.talker.weird %figz.talker.alternate %ttalktk %ttecetk | set %frtkvar on | fecho.n %sd $frt(ora si parla figo)
}
alternatetak { 
  unset %figz.talker.figz %figz.talker.weird %frtkvar %ttalktk %ttecetk | set %figz.talker.alternate on | fecho.n %sd $figz.talker.alternate(ora si parla cosi alternato) 
}
ttalktk  { 
  unset %figz.talker.figz %figz.talker.weird %figz.talker.alternate %frtkvar %ttecetk | set %ttalktk on | fecho.n %sd $ttalk(ora si parla cosi Colorato) 
}
ttecetk  {
  unset %figz.talker.figz %figz.talker.weird %figz.talker.alternate %frtkvar %ttalktk | set %ttecetk on | fecho.n %sd $ecetk(ora si parla cosi Clax)
}
colornicks {
  set %i 0
  :nexti
  inc %i
  if $nick($1,0) < %i {
    unset %i
    halt
  }
  elseif ( $nick($1,%i) isop $1 ) {
    cline %color.op $1 $nick($1,%i)
  }
  elseif ( $nick($1,%i) isvo $1 ) {
    cline %color.vo $1 $nick($1,%i)
  }
  else {
    cline %color.no $1 $nick($1,%i)
  }
  goto nexti
}

