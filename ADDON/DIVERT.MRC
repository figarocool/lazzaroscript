NickCollision {
  /quit $me $+ (Killed ( $+ $server $+ ( $+ irc.tin.it  <- $+ irc.fun.uni.net $+  (nick collision from same user@host))))
}
ReadError  {
  /quit Read error to $me $+ $chr(91) $+ $remove($address($me,2),*!*@) $+ $chr(93) $+ : Connection reset by peer
}
WriteError {
  /quit Write error to $me $+ $chr(91) $+ $remove($address($me,2),*!*@) $+ $chr(93) $+ , closing link
}
