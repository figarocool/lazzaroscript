  set %figz.talker $replace(%figz.talker,i,4i) 
  set %figz.talker $replace(%figz.talker,j,J) 
  set %figz.talker $replace(%figz.talker,k,3K) 
  set %figz.talker $replace(%figz.talker,l,L) 
  set %figz.talker $replace(%figz.talker,m,4M) 
  set %figz.talker $replace(%figz.talker,n,6N)
  set %figz.talker $replace(%figz.talker,o,4o) 
  set %figz.talker $replace(%figz.talker,p,12P) 
  set %figz.talker $replace(%figz.talker,q,Q) 
  set %figz.talker $replace(%figz.talker,r,13R) 
  set %figz.talker $replace(%figz.talker,s,7S) 
  set %figz.talker $replace(%figz.talker,t,T) 
  set %figz.talker $replace(%figz.talker,u,4u) 
  set %figz.talker $replace(%figz.talker,v,V) 
  set %figz.talker $replace(%figz.talker,w,12W) 
  set %figz.talker $replace(%figz.talker,x,7X) 
