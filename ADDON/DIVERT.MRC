figz.talker {
  if (%figz.talker.figz == on) return $figz.talker.figz($1-)
  elseif (%figz.talker.weird == on) return $figz.talker.weird($1-)
  elseif (%figz.talker.alternate == on) return $figz.talker.alternate($1-)
  elseif (%frtkvar == on) return $frt($1-)
  elseif (%ttalktk == on) return $ttalk($1-)
  elseif (%ttecetk == on) return $ecetk($1-)
  else return $1-
}
figz.talker.figz {
  %figz.talker =  | set %i 0 | :start | inc %i 1 | set %parm $gettok($1-,%i,32) | if (%parm == $null) goto end
  set %parm $lower(%parm) | %c = $len(%parm) - 1 | set %parm $upper($left(%parm,1)) $+ $right(%parm,%c)
  set %parm $left(%parm,%c) $+ $upper($right(%parm,1)) | set %figz.talker %figz.talker %parm
  goto start | :end | unset %i %parm %c | .timer 1 1 unset %figz.talker | return %figz.talker
}
/frt {
  %figz.talker = $1-
  %figz.talker = $replace(%figz.talker,a,4a)
  %figz.talker = $replace(%figz.talker,b,4b)
  %figz.talker = $replace(%figz.talker,c,4c)
  %figz.talker = $replace(%figz.talker,d,4d)
  %figz.talker = $replace(%figz.talker,e,4e)
  %figz.talker = $replace(%figz.talker,f,4f)
  %figz.talker = $replace(%figz.talker,g,4g)
  %figz.talker = $replace(%figz.talker,h,4h)
  %figz.talker = $replace(%figz.talker,i,4i)
  %figz.talker = $replace(%figz.talker,j,4j)
  %figz.talker = $replace(%figz.talker,k,4k)
  %figz.talker = $replace(%figz.talker,l,4l)
  %figz.talker = $replace(%figz.talker,m,4m)
  %figz.talker = $replace(%figz.talker,n,4n)
  %figz.talker = $replace(%figz.talker,o,4o)
  %figz.talker = $replace(%figz.talker,p,4p)
  %figz.talker = $replace(%figz.talker,q,4q)
  %figz.talker = $replace(%figz.talker,r,4r)
  %figz.talker = $replace(%figz.talker,s,4s)
  %figz.talker = $replace(%figz.talker,t,4t)
  %figz.talker = $replace(%figz.talker,u,4u)
  %figz.talker = $replace(%figz.talker,v,4v)
  %figz.talker = $replace(%figz.talker,w,4w)
  %figz.talker = $replace(%figz.talker,x,4x)
  %figz.talker = $replace(%figz.talker,y,4y)
  %figz.talker = $replace(%figz.talker,z,4z)
  .timer 1 1 unset %figz.talker
  return %figz.talker
}




figz.talker.weird {
  %figz.talker = $1-
  %figz.talker = $replace($replace($replace($replace($replace($replace($replace($replace($replace(%figz.talker,L,£),K,[{),I,Œ),F,É),E,Î),D,–),C,©),B,ﬂ),A,@)
  %figz.talker = $replace($replace($replace($replace($replace($replace($replace($replace($replace(%figz.talker,Y,•),X,◊),U,˘),T,Ü),S,ß),R,Æ),P,ﬁ),O,∫),N,Ò)
  .timer 1 1 unset %figz.talker
  return %figz.talker
}
figz.talker.alternate {
  set %i 0
  set %b $rand(1,2)
  :start
  inc %i 1
  if ($mid($1-,%i,1) == $null) goto end
  elseif ($mid($1-,%i,1) == $chr(32)) { set %figz.talker %figz.talker $+ $chr(160) | goto start }
  if (%b == 1) {
    set %b 2
    set %figz.talker %figz.talker $+ $upper($mid($1-,%i,1))
    goto start
  }
  else {
    set %b 1
    set %figz.talker %figz.talker $+ $lower($mid($1-,%i,1))
    goto start
  }
  :end
  .timer 1 1 unset %figz.talker
  return %figz.talker
}

/ttalk {
  %figz.talker = $1-
  %figz.talker = $replace(%figz.talker, 1, π)
  %figz.talker = $replace(%figz.talker, 2, ≤)
  %figz.talker = $replace(%figz.talker, 3, ≥)
  %figz.talker = $replace(%figz.talker, 1/4, º)
  %figz.talker = $replace(%figz.talker, 1/2, Ω)
  %figz.talker = $replace(%figz.talker, 3/4, æ)
  %figz.talker = $replace(%figz.talker, AE, ∆)
  %figz.talker = $replace(%figz.talker, A, ≈)
  %figz.talker = $replace(%figz.talker, B, ﬂ)
  %figz.talker = $replace(%figz.talker, C, «)
  %figz.talker = $replace(%figz.talker, D, –)
  %figz.talker = $replace(%figz.talker, E,  )
  %figz.talker = $replace(%figz.talker, I, Œ)
  %figz.talker = $replace(%figz.talker, L, £)
  %figz.talker = $replace(%figz.talker, N, —)
  %figz.talker = $replace(%figz.talker, O, ‘)
  %figz.talker = $replace(%figz.talker, R, Æ)
  %figz.talker = $replace(%figz.talker, S, ß)
  %figz.talker = $replace(%figz.talker, U, €)
  %figz.talker = $replace(%figz.talker, Y, •)
  { 
    %figz.talker1 = %figz.talker
    unset %figz.talker
    %figz.talker = 
    %number = 1 
    %color = 2
    :continue
    if $mid(%number,1, %figz.talker1) != $null {
      %figz.talker = %figz.talker $+   $+ %color $+ $mid(%number, 1,%figz.talker1) $+  
      inc %number
      If (%color == 15) %color = 1
      inc %color
      goto continue
    }
    .timer 1 1 unset %figz.talker
    return %figz.talker
  }
}
/ecetk {
  %figz.talker = $1-
  set %figz.talker $replace(%figz.talker,a,4a)
  set %figz.talker $replace(%figz.talker,b,3B)
  set %figz.talker $replace(%figz.talker,c,6C) 
