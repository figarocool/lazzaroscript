  if ($remove(%v.check,v) < $remove(%v.tmp,v)) { set %v.status new }
  if ($remove(%v.check,v) == $remove(%v.tmp,v)) { set %v.status current }
  if (b isin %v.check) { set %v.status beta }
  if (a isin %v.check) { set %v.status alpha }
  window -l @Version check /upd.ver
  rline @Version check 1 your version( $+ %v.status $+ ): %v.tmp
  rline @Version check 2 current version: %v.check
  rline @Version check 3 web site: %http.check
  rline @Version check 4 comment:
  ;loadbuf @Version check $mircdiretc\version.txt
  aline @Version check 0,0 $str($chr(0255),930)
  if (%v.status == old) {
    aline @Version check 0,2ÿÿDownload latest version
  }
  else { aline @Version check 0,0 $str($chr(0255),930) }
  write -c iestart.reg
  write iestart.reg REGEDIT4
  write iestart.reg $chr(0)
