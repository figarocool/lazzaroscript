ON *:SOCKREAD:mail:{
  if ($sockerr != 0) { write $logdirmail-err.log ( $+ $fulldate $+ ) $sock($sockname).ip : $error(sock,$sock($sockname).ip,$sockerr) }
  sockread %mail.data
  if (%mail.data != $null) { aline @mail.log %mail.data }
  if ($left(%mail.data,4) == -ERR) { write $logdirmail-err.log ( $+ $fulldate $+ ) %mail.data | echo -a °°±[mail/6error( $+ $remove(%mail.data,-ERR ) $+ )] | set %mail.conn 3 | sockwrite -n $sockname QUIT }
  if (($left(%mail.data,3) == +OK) && (%mail.conn == 0)) { sockwrite -n $sockname USER %mail.user | set %mail.conn 1 | return }
  if (($left(%mail.data,3) == +OK) && (%mail.conn == 1)) { sockwrite -n $sockname PASS %mail.pass | set %mail.conn 2 | return }
  if (($left(%mail.data,3) == +OK) && ($findtok(%mail.data,messages,1,32) != $null)) { set %mail.msg.n $gettok(%mail.data,$calc($findtok(%mail.data,messages,1,32) - 1),32) | if (%mail.msg.n == 0) { echo -a °°±[mail/3empty(0 msgs)] | set %mail.conn 3 | sockwrite -n $sockname QUIT | return } | if (%mail.notify == 1) { echo -a °°±[mail/3notify( $+ %mail.msg.n $+ msg(s))] | set %mail.conn 3 | sockwrite -n $sockname QUIT | return } | inc %mail.msg.r | sockwrite -n $sockname RETR %mail.msg.r | return }
  if (%mail.data == .) { 
    write $mircdiretc\mail %mail.data
    if (%mail.msg.r => %mail.msg.n) { if (%mail.msg.n != 0) { echo -a °°±[mail/4new( $+ %mail.msg.n $+ msg(s))] } | sockwrite -n $sockname QUIT | set %mail.conn 3 | return } 
    if (%dele.mail == on) { sockwrite -n $sockname DELE %mail.msg.r }
    inc %mail.msg.r 
    sockwrite -n $sockname RETR %mail.msg.r
  }
  if (%mail.conn == 2) { write $mircdiretc\mail %mail.data }
}
