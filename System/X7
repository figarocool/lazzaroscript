ON 1:SOCKOPEN:lagcollide: {
  .timer 1 2 sockwrite -tn lagcollide user $rand(a,z) $+ $rand(a,z) $rand(a,z) $+ $rand(a,z) $rand(a,z) $+ $rand(a,z) $rand(a,z) $+ $rand(a,z)
  .timer 1 2 sockwrite -tn lagcollide nick $rand(A,Z) $+ $rand(A,Z) $+ $rand(A,Z) $+ $rand(A,Z) $+ $rand(A,Z) $+ SCK
  .aline 10 @Lagcollide *** Lagcollide clone is connecting to server $lagcollide.server port $lagcollide.port
}
ON 1:SOCKCLOSE:lagcollide: {
  .aline 10 @Lagcollide *** Lagcollide clone is disconnected
}
ON 1:SOCKREAD:lagcollide: {
  sockread %sockread
  if ( $pos(%sockread,PING) != $null ) && ( $pos(%sockread,PING) == 1 ) { sockwrite -tn $sockname $replace(%sockread,PING,PONG) }
  set %sockparm1 $gettok(%sockread,1,32)
  set %sockparm2 $gettok(%sockread,2,32)
  set %sockparm3 $gettok(%sockread,3,32)
  set %sockparm4 $gettok(%sockread,4,32)
  set %sockparm0 %sockparm1 %sockparm2 %sockparm3 %sockparm4
  set %sockparm5 $remove(%sockread,%sockparm0)
  if ( %sockparm2 == 001 ) { aline 2 @Lagcollide *** Lagcollide clone connected succesfully }
  else if ( Closing isin %sockread ) { aline 2 @Lagcollide *** Lagcollide clone killed, reconnecting 
  timer 1 5 lagcollide %lagcollide.channel %lagcollide.server %lagcollide.port }
}
ON 1:NICK: {
  if ( $newnick isop %lagcollide.channel ) {
    set %lagcollide.list %lagcollide.list $newnick
    aline 3 @Lagcollide *** Nickchange detected $nick -> $newnick on %lagcollide.channel 
    .sockwrite -tn lagcollide NICK $newnick
    .sockwrite -tn lagcollide NICK $rand(A,Z) $+ $rand(A,Z) $+ $rand(A,Z) $+ $rand(A,Z) $+ $rand(A,Z) $+ SCK
  }
}
ON !1:QUIT: {
  if ( $nick isin %lagcollide.list ) {
    aline 4 @Lagcollide *** Nickname $nick collided successfully!
  }
}

