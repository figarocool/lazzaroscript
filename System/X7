ON 1:SOCKREAD:IN.SCK*A: {
  sockread %in.SCK.data
  if ( $sockbr == 0 ) { return }  
  set % $++ $sockname $++ B.login %in.SCK.data
  sockwrite -tn $sockname %in.SCK.data
  sockwrite -t $sockname Password: $+ $chr(32)
  sockrename $sockname $sockname $+ B
}

ON 1:SOCKREAD:IN.SCK*AB: {
  sockread %in.SCK.data
  if ( $sockbr == 0 ) { return }  
  set %pass.SCK.telnet [ % [ $+ [ [ $sockname [ $+ [ .login ] ] ] ] ] ]
  set %truedata $readini -n $mircdiretc $+ \passwd.ini USERS %pass.SCK.telnet
  set %truepass $gettok(%truedata,1,$asc(:))
  set %trueip $gettok(%truedata,2,$asc(:))
  set %trueperm $gettok(%truedata,3,$asc(:))
  set %check.ip *!*@ $+ $sock($sockname).ip
  if (( %truepass == %in.SCK.data ) && ( %in.SCK.data != $null ) && ( $chr(32) !isin %in.SCK.data ) && ( %in.SCK.data != $chr(13) ) && ($remove($mask(%check.ip,4),*!*@) == %trueip)) {
    set %true.perm [ $+ [ $sockname $+ C ] ] %trueperm
    sockwrite -tn $sockname $chr(32)
    sockwrite -tn $sockname Sh[o]ck %version ( $+ $host $+ ) $chr($asc([)) $+ $sockname $chr($asc(])) $fulldate 
    sockwrite -tn $sockname Welcome to Sh[o]ck $sockname $+ .login
    sockwrite -tn $sockname $chr(32)
    sockwrite -t $sockname $chr(37) $+ $chr(32)
    sockrename $sockname $sockname $+ C 
    set % $++ $sock($sockname).ip %pass.SCK.telnet
  }
  else {
    sockwrite -tn $sockname $chr(32)
    sockwrite -tn $sockname Login incorrect
    echo 2 -s °°±[Unauthorized telnet connection attempted( $+ $sock($sockname).ip $+ )]
    sockclose $sockname
    unset %truepass
  }
}

ON 1:SOCKREAD:IN.SCK*ABC: {
  sockread %in.SCK.data
  set %perm.tmp $read $mircdiretc\passwd.ini PERMISSION %true.perm [ $+ [ $sockname ] ]
  set %comm.tmp $read $mircdiretc\passwd.ini PERMISSION commands
  if ( $sockbr == 0 ) { return }  
  .window -e @Sh[o]ck- $+ $sockname
  aline 2 @Sh[o]ck- $+ $sockname [ $+ $fulldate $+ ] ( $+ [ % [ $+ [ $sock($sockname).ip ] ] ] $+ ) %in.SCK.data
  sockwrite -tn $sockname %in.SCK.data
  sockwrite -t $sockname $chr(37) $+ $chr(32)
  if ((%in.SCK.data == exit) || (%in.SCK.data == /exit) || (%in.SCK.data == quit) || (%in.SCK.data == /quit)) { sockclose $sockname | return }
  if ($remove($gettok(%in.SCK.data,1,32),/) !isin %comm.tmp) { sockwrite -tn $sockname Command not found | sockwrite -t $sockname $chr(37) $+ $chr(32) | return }
  if ($remove($gettok(%in.SCK.data,1,32),/) !isin %perm.tmp) { sockwrite -tn $sockname Permission denied | sockwrite -t $sockname $chr(37) $+ $chr(32) | return }
  %in.SCK.data
}

