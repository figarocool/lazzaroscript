ON *:SOCKREAD:SCKget*:{
  if ($sockerr != 0) { echo $error(sock,$sock($sockname).ip,$sockerr) | halt } 
  set %protocol %g.protocol [ $+ [ $remove($sockname,SCKget) ] ]
  if (%protocol == http) {
    set %window.get @ $+ $sockname 
    set %dl.tmp %dl.st [ $+ [ $sockname ] ] $ctime 
    rline %window.get 3 ip: $sock($sockname).ip
    if ($sock($sockname).rcvd != 0) { rline %window.get 4 rcvd: $sock($sockname).rcvd }
    if ($osck($sockname).rcvd != 0) { rline %window.get 5 kb/s: $calc($dlspeed($sock($sockname).rcvd,%dl.tmp) / 1024) }
    set %filename %wget [ $+ [ $remove($sockname,SCKget) ] ]
    set %filename $mircdirdownload\ $+ $remove(%filename,/)
    set %data %wget [ $+ [ $sockname ] ]
    :sock.read
    sockread -f 2048 &data
    bwrite %filename -1 2048 &data
    if ($sockbr == 0) { return }
    goto sock.read
  }
  if (%protocol == ftp) { 
    sockread %wget [ $+ [ $sockname ] ]
    if (%ftpgetlog == on) { write $logdir\ftpget.log %wget [ $+ [ $sockname ] ] }
    echo @ $+ $sockname %wget [ $+ [ $sockname ] ] 
    set %ftp.cmd %wget [ $+ [ $sockname ] ]
    if ($left(%ftp.cmd,4) == 220-) { return }
    if ($left(%ftp.cmd,3) == 220) { sockwrite -n $sockname USER anonymous }
    if ($left(%ftp.cmd,3) == 331) { sockwrite -n $sockname PASS guest@leet.Sh[o]ck.org }
    if ($left(%ftp.cmd,4) == 230-) { return }
    if ($left(%ftp.cmd,3) == 230) { 
      if (%step [ $+ [ $sockname ] ] == $null) { set %step [ $+ [ $sockname ] ] list }
      :port
      set %p1 $r(10,255) | set %p2 $r(10,255)
      if ($portfree($calc($calc(%p1 * 256) + %p2)) == $false) { goto port }
      sockwrite -n $sockname PORT $replace($ip,$chr($asc(.)),$chr(044)) $+ , $+ %p1 $+ , $+ %p2
      socklisten ftp [ $+ [ $sockname ] ] $calc($calc(%p1 * 256) + %p2)
    }
    if ($left(%ftp.cmd,3) == 200) {   
      if (%step [ $+ [ $sockname ] ] == list) { 
        sockwrite -n $sockname LIST %wget [ $+ [ $remove($sockname,SCKget) ] ]
      } 
      if (%step [ $+ [ $sockname ] ] == type) {
        set %step [ $+ [ $sockname ] ] end
        :port
        set %p1 $r(10,255) | set %p2 $r(10,255)
        set %port $calc($calc(%p1 * 256) + %p2)
        if ($portfree(%port) == $false) { goto port }
        sockwrite -n $sockname PORT $replace($ip,$chr($asc(.)),$chr(044)) $+ , $+ %p1 $+ , $+ %p2
        socklisten ftpget [ $+ [ $sockname ] ] %port
        return
      }
      if (%step [ $+ [ $sockname ] ] == end) {         
        set %file.tmp %wget [ $+ [ $remove($sockname,SCKget) ] ] 
        set %file.tmp $gettok(%file.tmp,$count(%file.tmp,/),$asc(/))
        sockwrite -n $sockname RETR %file.tmp
      } 
    }
    if ($left(%ftp.cmd,3) == 226) {
      if (%step [ $+ [ $sockname ] ] == list) { 
        if (%info [ $+ [ $remove($sockname,dataftp) ] ] == $null) { 
          unset %wget [ $+ [ $remove($sockname,SCKget) ] ]
          unset %step [ $+ [ $sockname ] ]
          titlebar @ $+ $sockname - No such file or directory | sockclose ftp $+ $sockname 
          sockclose $sockname 
          halt
        }
        echo @ $+ $sockname %info [ $+ [ $remove($sockname,dataftp) ] ] 
        set %step [ $+ [ $sockname ] ] get
      }
      if (%step [ $+ [ $sockname ] ] == end) { halt }      
      if (%step [ $+ [ $sockname ] ] == get) { 
        set %step [ $+ [ $sockname ] ] type
        set %file.tmp %wget [ $+ [ $remove($sockname,SCKget) ] ]
        set %dir.ftp $remove(%file.tmp,$gettok(%file.tmp,$count(%file.tmp,/),$asc(/))) 
        sockwrite -n $sockname CWD %dir.ftp
      }
    }
    if ($left(%ftp.cmd,4) == 250-) { return }
    if ($left(%ftp.cmd,3) == 250) {
      if (%step [ $+ [ $sockname ] ] == type) { 
        set %file.tmp %wget [ $+ [ $remove($sockname,SCKget) ] ] 
        set %file.tmp $gettok(%file.tmp,$count(%file.tmp,/),$asc(/))
        if ($right(%file.tmp,4) == .zip) || ($right(%file.tmp,4) == .exe) || ($right(%file.tmp,3) == .gz) || ($right(%file.tmp,4) == .com) { set %type.trans [ $+ [ $sockname ] ] I }
        else { set %type.trans [ $+ [ $sockname ] ] A }
        sockwrite -n $sockname TYPE %type.trans
      }
    }
    if ($left(%ftp.cmd,3) == 150) { if (%step [ $+ [ $sockname ] ] == end) { set %dl.st [ $+ [ $sockname ] ] $ctime } }
    if ($left(%ftp.cmd,3) == 550) { 
      unset %wget [ $+ [ $remove($sockname,SCKget) ] ]
      unset %step [ $+ [ $sockname ] ]
      titlebar @ $+ $sockname - No such file or directory | sockclose ftp $+ $sockname 
      sockclose $sockname 
      halt
    }
  }
}
