/start {
  window -adhopl +Lfn  @Start 0 335 150 197
  .aline @start 4SCRIPT CONTROL
  /splay $mircdirsounds\wavs\ok.wav
  .aline @start 9boot files1.lllll9[ok]
  .aline @start 9sound1...lll....9[ok]
  .aline @start 9nukes1ll........9[ok]
  .aline @start 9antinukes1llll.9[ok]
  .aline @start 9multiserver1ll9[ok]
