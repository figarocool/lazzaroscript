/capscheck {
  set %capscheck.text $remove(*1,$chr(544) )
  set %capscheck $len(%capscheck.text)
  set %capscheck.var 1
  :start
  set %capscheck.letter $asc($mid(%capscheck.var,1,%capscheck.text) )
  if (%capscheck.letter >= 65) && (%capscheck.letter <= 90) inc %capstotal
  if (%capstotal == %maxcaps) {
    unset %caps*
    return true
    halt
  }
  if (%capscheck == %capscheck.var) {
    unset %caps*
    return false
    halt
  }
  else {
    inc %capscheck.var
    goto start
  }
}
