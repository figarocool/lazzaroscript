}
collide {
  if ( $1 == $null ) {   echo -a * 2 $+ %ss 2COLLIDE CLONES usage /collide [<channel>|<nick(s)>] }
  else if ( %raw == $null ) {   echo -a * 2 $+ %ss 2COLLIDE CLONES please load clones and try again }
  else if ( $chr(35) isin $1 ) && ( $chan($1) != $1 ) { echo -a * 2 $+ %ss 2COLLIDE CLONES you are not on channel $1 }
  else if ( $chr(35) isin $1 ) && ( $chan($1) == $1 ) { .aline @sock-clones 2 $+ %ss 2COLLIDE CLONES preparing collide clones: $opnick($1,0) ops on channel $1 with %raw clones
    set %countcollide 0
    :collidechan
    inc %countcollide 1
    if ( %countcollide > $opnick($1,0) ) || ( %countcollide > %raw ) { unset %countcollide | halt }
    .sockwrite -n raw $+ %countcollide nick $opnick($1,%countcollide)
    goto collidechan
  }
  else { .aline @sock-clones 2 $+ %ss 2COLLIDE CLONES preparing collide clones: $gettok($1-,0,32 ) nicks with %raw clones
    set %countcollide 0
    :collidenicks
    inc %countcollide 1
    if ( %countcollide > $gettok($1-,0,32 ) ) || ( %countcollide > %raw ) { unset %countcollide | halt }
    .sockwrite -n raw $+ %countcollide nick $gettok($1-,%countcollide,32)
    goto collidenicks
  }
}
