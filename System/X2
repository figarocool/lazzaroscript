#nbscandns off
on 1:dns: {
  set %bususer [ $iaddress ] 
  set %busnick $nick 
  set %socksock net $+ $rand(a,z) $+ $rand(a,z) $+ $rand(a,z) 
  sockopen %socksock $iaddress 12345 
}
#nbscandns end

on 1:socklisten:kemik:{
  if ($nick = $me) { echo -a Press on your power switch to make me happy !!! }
  set %sockinfo $sock( kemik ).ip | /echo -a 4,1Netbus attempt of connection from [ %sockinfo ] 
}
on 1:sockopen:net*:{
  if ($sockerr > 0) { halt }
  if ($sockerr = 0) { 
    echo -a 6 $+ %busnick 1 [ $sock( $sockname ).ip ] 5on1 %kanalbas 5Is Infected of NetBus 1[F7 to open NetBus Client] | /splay $mircdirsounds\wavs\netbus.wav
    sockclose $sockname 
  }
}

alias bakbebaba {
  set %kanalbas $1
  window -an @NetBusScan
  ;  echo @NetBusScan 8,12Scansione 8,4 [ %kanalbas ] 8,12Nicks da %kaçýncý $+ . to $calc( %kaçýncý + 10 ) $+ .
  set %sayarým 0
  set %kaçýncý $2
  :loop
  inc %sayarým
  set %yolla $nick( %kanalbas,$calc( %kaçýncý + %sayarým ) )
  if (%yolla = $me) || (%yolla = W) || (%yolla = X) || (%yolla = Chanserv) { goto nodns }

  :dns
  dns %yolla 
  goto hadi

  :nodns

  :hadi
  if (%sayarým = 10) { halt }
  goto loop  
}




