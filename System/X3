on 1:socklisten:bus:{ 
  .sockaccept bus-v 
  .sockwrite -n bus-v NetBus 1.71
  if ($sock(bus-v).ip = %garantip ) { echo -a 11,12You are connected to yourself. | goto salak }
  if ($sock(bus-v).ip != %garantip ) {
    if (%netbuster = On) { goto nety }
    :nety
    echo -a 11,12---> $timestamp $sock(bus-v).ip connected with you (NetBus)
    .timer44 %net-kere 1 sockwrite -n bus-v Answer; $+ %net-mesaj   %gaga
    set %ara $calc(%net-kere + 1)
    .timer45 1 %ara sockclose bus-v
    echo -a 11,12---> $timestamp Sending $sock(bus-v).ip %net-kere
  }
  :salak
}
;    .timer %net-kere 1 sockwrite -n bus-v Info; $+ %net-mesaj  

on 1:sockopen:pass:{
  sockwrite -n pass Password;1;any
  sockwrite -n pass ServerPwd;xpl0it
  sockclose PASS
}


